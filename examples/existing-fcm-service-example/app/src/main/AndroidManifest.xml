<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GameApplication"
        android:label="@string/app_name"
        android:icon="@drawable/ic_stat_game"
        android:allowBackup="false">

        <!-- The game's own notification defaults, which the setup plugin reuses for OpenPush. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_game" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="game_news" />

        <!-- Example only: a status screen for device tests. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game's own service keeps receiving every push. OpenPush's merged service stays in
             the manifest but is disabled at runtime: the plugin sets ai.openpush.fcm.delivery to
             forward from openpush-setup.json, so this file needs no OpenPush entries at all. -->
        <service
            android:name=".GameMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
