<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own service next to the OpenPush FCM module's merged service, declared here so the
     fixture needs no SDK artifact. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Two services">
        <service
            android:name=".GameMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="ai.openpush.android.fcm.OpenPushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
